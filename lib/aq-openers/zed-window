#!/usr/bin/env bash
#
# aq opener for Zed: brings forward the window for the session's project
# folder, by window title. Zed titles a window after its project folder,
# e.g. "tc-5031 — README.md". If no window is open on the folder itself, it
# tries each folder above it, nearest first, in case the agent has moved into
# a subfolder of the project.
#
# The zed CLI can't do this: `zed <dir>` opens a new window when
# cli_default_open_behavior is "new_window", and `zed -e <dir>` opens the
# folder in whichever window is current.
#
# Needs Accessibility permission for whatever runs aq: SwiftBar, or your
# terminal.
#
# See "Openers" in the README for what an opener gets and must do.

name="$(basename "$AQ_CWD")"

# The folder's name, then its parents', stopping short of $HOME and /.
names=()
dir="${AQ_CWD%/}"
while [ -n "$dir" ] && [ "$dir" != "/" ] && [ "$dir" != "$HOME" ]; do
  names+=("$(basename "$dir")")
  dir="$(dirname "$dir")"
done
[ ${#names[@]} -gt 0 ] || names=("$name")

result="$(osascript - "${names[@]}" 2>&1 <<'EOF'
on run argv
  tell application "System Events"
    if not (exists process "Zed") then return "no-zed"
    tell process "Zed"
      repeat with folderName in argv
        set folderName to folderName as text
        set matches to (every window whose name is folderName or name starts with (folderName & " "))
        if matches is not {} then
          perform action "AXRaise" of item 1 of matches
          set frontmost to true
          return "ok"
        end if
      end repeat
    end tell
  end tell
  return "no-window"
end run
EOF
)"
case "$result" in
  ok) exit 0 ;;
  no-zed) echo "Zed isn't running." ;;
  no-window) echo "No Zed window is open on $name." ;;
  *assistive\ access*|*-1719*|*-25211*)
    echo "aq needs Accessibility permission to switch Zed windows. Add SwiftBar (or your terminal) in System Settings > Privacy & Security > Accessibility." ;;
  *) echo "Couldn't switch to the Zed window for $name: $result" ;;
esac
exit 1
