#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
source "$(dirname "$SELF")/../lib/aq.sh"

NOW="$(aq_now)"

usage() {
  cat <<EOF
Usage: $(basename "$0") [command] [args]

Lists your coding agents' sessions, the ones waiting for you first. Each
agent's hooks record the state (see aq-record); a session stays flagged until
you reply to it.

Commands:
  list [-a]             List sessions that need input, then idle ones, then
                        working ones, oldest first. -a also shows snoozed
                        sessions, and ones you haven't prompted yet. This is
                        the default.
  open <n|id>           Switch to the session: its tmux pane if it has one,
                        or else whatever its app's opener does (see the
                        README).
  snooze <n|id> [dur]   Hide the session for a while (e.g. 30m, 2h, 1d).
                        The default is 1h.
  dismiss <n|id>        Take the session off the list. It comes back when
                        you next send it a prompt.
  prune [days]          Remove sessions whose directory or agent process
                        has gone, and sessions untouched for longer than
                        <days> (default \$AQ_PRUNE_DAYS or 3).
  --swiftbar            Print the list in SwiftBar's menu format.

<n> is a row number from the list. <id> is a session ID or a prefix of one.
EOF
}

# Prints a message, and also shows it as a notification, since nobody sees
# the output when SwiftBar runs aq.
notify() {
  echo "$1" >&2
  terminal-notifier -title aq -message "$1" -group aq >/dev/null 2>&1 || true
}

# aq's settings. $AQ_CONFIG_DIR/config.json, in the same shape, is merged
# over these.
#
# apps: the apps aq knows, by bundle ID: the name and emoji to show, and the
# opener that switches to a session (see run_opener). Other apps get 💻,
# their TERM_PROGRAM as a name, and the "activate" opener.
#
# agents: the name and emoji to show for each agent. Other agents show their
# own name, and no emoji.
#
# repos: an emoji to show for each repo, by name (see repo_name in
# aq-record), e.g. {"tc": "📰"}.
CONFIG='{
  "apps": {
    "dev.zed.Zed": {"name": "Zed", "emoji": "⚡", "open": "zed-window"},
    "org.tabby": {"name": "Tabby", "emoji": "🐈"}
  },
  "agents": {
    "claude": {"name": "Claude", "emoji": ""},
    "codex": {"name": "Codex", "emoji": "🤖"}
  },
  "repos": {}
}'
if [ -f "$AQ_CONFIG_DIR/config.json" ]; then
  if merged="$(jq -s '.[0] * .[1]' <(echo "$CONFIG") "$AQ_CONFIG_DIR/config.json" 2>/dev/null)"; then
    CONFIG="$merged"
  else
    notify "Ignoring $AQ_CONFIG_DIR/config.json, which isn't valid JSON."
  fi
fi

# Prints the bundle ID of the app a process belongs to, from the
# __CFBundleIdentifier that macOS passes to every process an app starts.
process_app() {
  ps -E -o command= -p "$1" 2>/dev/null | tr ' ' '\n' | sed -n 's/^__CFBundleIdentifier=//p' | head -n1
}

# Prints, as JSON, where each tmux pane is showing: its tmux session, and the
# terminal (TTY and app) most recently active on that session, if any:
# {"%16": {"session": "4", "client_tty": "/dev/ttys008", "app": "org.tabby"}}.
#
# The hook can't record this for a session in tmux: the tmux server's
# environment comes from whichever app first started it, and you can attach
# to a tmux session from more than one terminal.
tmux_json() {
  local panes clients s activity tty pid
  if ! command -v tmux >/dev/null || ! panes="$(tmux list-panes -a -F '#{pane_id}	#{session_name}' 2>/dev/null)"; then
    echo '{}'
    return
  fi
  clients="$(tmux list-clients -F '#{session_name}	#{client_activity}	#{client_tty}	#{client_pid}' 2>/dev/null \
    | while IFS=$'\t' read -r s activity tty pid; do
        printf '%s\t%s\t%s\t%s\n' "$s" "$activity" "$tty" "$(process_app "$pid")"
      done)"
  jq -n --arg panes "$panes" --arg clients "$clients" '
    def rows: split("\n") | map(select(. != "") | split("\t"));
    ($clients | rows
      | map({session: .[0], activity: (.[1] | tonumber), client_tty: .[2], app: .[3]})
      | group_by(.session) | map(max_by(.activity) | del(.activity)) | INDEX(.session)) as $clients
    | $panes | rows
    | map({key: .[0], value: ({session: .[1]} + ($clients[.[1]] // {}))})
    | from_entries'
}
TMUX_JSON="$(tmux_json)"

# jq with the definitions the commands share.
aq_jq() {
  jq --argjson now "$NOW" --arg home "$HOME" --argjson config "$CONFIG" --argjson tmux "$TMUX_JSON" "$@"
}

JQ_DEFS='
  def age: ($now - .) as $s
    | if $s < 60 then "now"
      elif $s < 3600 then "\($s / 60 | floor)m"
      elif $s < 86400 then "\($s / 3600 | floor)h"
      else "\($s / 86400 | floor)d" end;
  def place: (.cwd // "?") | if . == $home then "~" else split("/") | last end;
  def repo_emoji: $config.repos[.repo // ""] // "";
  # The agent: {name, emoji}. Sessions recorded before aq-record stored the
  # agent are Claude.
  def agent: (.agent // "claude") as $a | {name: $a, emoji: ""} + ($config.agents[$a] // {});
  def title: .title // "" | select(. != "");
  # Where the session is showing in tmux, if it runs in tmux: see tmux_json.
  def tmux: $tmux[.tmux_pane // ""];
  # The app the session runs in: {id, name, emoji, open}. For a session in
  # tmux, that is the terminal showing its tmux session. A session with no
  # bundle ID recorded is matched on TERM_PROGRAM.
  def app:
    (if tmux then (tmux.app // "") else (.app // "") end) as $id
    | (if tmux then "" else (.term_program // "") end) as $term
    | $config.apps as $apps
    | ([$apps[] | select(.name == $term)] | first) as $by_name
    | if $apps[$id] then $apps[$id]
      elif tmux and $id == "" then {name: "tmux", emoji: "💻"}
      elif $id == "" and $by_name then $by_name
      else {name: ([$term, $id, "terminal"] | map(select(. != "")) | first), emoji: "💻"}
      end
    | {id: $id, open: "activate"} + .;
  # e.g. "Tabby (ttys008)", or "tmux session 4, in Tabby".
  def where:
    if tmux then
      "tmux session \(tmux.session)"
      + (if tmux.client_tty then ", in \(app.name)" else ", which no terminal is showing" end)
    else
      app.name + (.tty // "" | if . == "" then "" else " (\(.))" end)
    end;
  def rank: {"needs-input": 0, "idle": 1, "working": 2}[.status // ""] // 3;
  # "new" is a session nobody has prompted yet, e.g. a Zed thread you opened
  # but never typed into.
  def visible($all):
    map(select($all or (.status != "new" and ((.snoozed_until // 0) <= $now))))
    | sort_by([rank, .updated_at]);
'

# remove_stale [days]
#
# Deletes the state of sessions whose directory has gone, or whose recorded
# agent process has exited (or whose PID now belongs to another process).
# Given <days>, also deletes sessions untouched for that long, and ones
# working or never prompted for over a day: they never sent Stop or
# SessionEnd. Prints a line per session it removes.
remove_stale() {
  local days="${1:-}" f id cwd status updated pid pid_started reason
  for f in "$AQ_STATE_DIR"/*.json; do
    [ -e "$f" ] || continue
    IFS=$'\x1f' read -r id cwd status updated pid pid_started < <(jq -r '
      [.session_id, .cwd, .status, (.updated_at // 0), .pid, .pid_started]
      | map(. // "" | tostring) | join("\u001f")' "$f")
    reason=""
    if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
      reason="directory gone"
    elif [ -n "$pid" ] && [ "$(aq_process_started "$pid")" != "$pid_started" ]; then
      reason="agent process gone"
    elif [ -n "$days" ] && [[ "$status" =~ ^(working|new)$ ]] && [ "$updated" -lt $((NOW - 86400)) ]; then
      reason="$status for over a day"
    elif [ -n "$days" ] && [ "$updated" -lt $((NOW - days * 86400)) ]; then
      reason="untouched for over $days days"
    fi
    if [ -n "$reason" ]; then
      rm -f "$f"
      echo "Removed ${id:0:8} ($cwd): $reason"
    fi
  done
}

# The sessions to show, as a JSON array, after dropping those that have gone.
states_json() {
  local files
  remove_stale >/dev/null
  files=("$AQ_STATE_DIR"/*.json)
  { [ -e "${files[0]}" ] && cat "${files[@]}" || true; } \
    | aq_jq -s --argjson all "$1" "$JQ_DEFS visible(\$all)"
}

# Turns a row number or session ID prefix into a session ID.
resolve() {
  local ref="$1" matches=() f
  if [[ "$ref" =~ ^[0-9]{1,3}$ ]]; then
    states_json false | jq -er --argjson n "$ref" '.[$n - 1].session_id // empty' \
      || { echo "No row $ref" >&2; return 1; }
    return
  fi
  for f in "$AQ_STATE_DIR/$ref"*.json; do
    [ -e "$f" ] && matches+=("$(basename "$f" .json)")
  done
  case "${#matches[@]}" in
    1) echo "${matches[0]}" ;;
    0) echo "No session matches $ref" >&2; return 1 ;;
    *) echo "More than one session matches $ref" >&2; return 1 ;;
  esac
}

cmd_list() {
  local all=false rows
  [ "${1:-}" = "-a" ] && all=true
  rows="$(states_json "$all" | aq_jq -r "$JQ_DEFS
    to_entries[]
    | [(.key + 1), .value.status, (.value.updated_at | age), (.value | (repo_emoji | if . == \"\" then \"\" else . + \" \" end) + place),
       (.value.branch // \"\"), (.value | \"\\(agent.name) in \\(app.name)\"), (.value | title // \"\"),
       (.value.message // \"\"), .value.session_id[0:8]]
    | map(tostring | gsub(\"[\\u001f\\n]\"; \" \")) | join(\"\\u001f\")")"
  if [ -z "$rows" ]; then
    echo "Nothing waiting for you."
    return 0
  fi
  local n status age place branch src title message short icon
  # \x1f rather than a tab, because read collapses runs of whitespace IFS
  # characters, which would lose empty fields.
  while IFS=$'\x1f' read -r n status age place branch src title message short; do
    case "$status" in
      needs-input) icon=$'\033[0;33m●\033[0m' ;;
      idle) icon=$'\033[2m○\033[0m' ;;
      working) icon=$'\033[0;34m●\033[0m' ;;
      *) icon=$'\033[2m…\033[0m' ;;
    esac
    printf '%2s %s %-4s %s' "$n" "$icon" "$age" "$place"
    if [ -n "$branch" ]; then printf ' \033[2m(%s)\033[0m' "$branch"; fi
    printf ' \033[2m[%s %s]\033[0m\n' "$src" "$short"
    if [ -n "$title" ]; then printf '        %s\n' "$title"; fi
    if [ -n "$message" ]; then printf '        \033[0;33m%s\033[0m\n' "$message"; fi
  done <<<"$rows"
}

# The export statements that give an opener the session's details.
#
# This stays in single quotes, outside any $(...): bash 3.2, which SwiftBar
# runs plugins with, brace-expands a {a, b} inside a double-quoted string
# inside $(...), which split this into several jq programs.
OPENER_ENV='
  {AQ_SESSION_ID: .session_id, AQ_CWD: .cwd, AQ_PLACE: place, AQ_TTY: .tty,
   AQ_APP: app.id, AQ_APP_NAME: app.name}
  | to_entries[] | "export \(.key)=\(.value // "" | @sh)"'

# run_opener <name> <session JSON>
#
# Runs the opener called <name>: an executable in $AQ_CONFIG_DIR/openers, or
# one of aq's own in lib/aq-openers. It gets the session's details as AQ_*
# environment variables. Whatever it prints is shown as a notification, and
# its exit status is aq open's.
run_opener() {
  local name="$1" session="$2" opener="" dir output status
  for dir in "$AQ_CONFIG_DIR/openers" "$(dirname "$SELF")/../lib/aq-openers"; do
    if [ -x "$dir/$name" ]; then
      opener="$dir/$name"
      break
    fi
  done
  if [ -z "$opener" ]; then
    notify "There's no aq opener called $name. Add one to $AQ_CONFIG_DIR/openers."
    return 1
  fi
  local exports
  exports="$(aq_jq -r "$JQ_DEFS $OPENER_ENV" <<<"$session")"
  status=0
  output="$(eval "$exports"; "$opener")" || status=$?
  [ -n "$output" ] && notify "$output"
  return "$status"
}

cmd_open() {
  [ $# -ge 1 ] || { usage >&2; exit 1; }
  local id session cwd place opener pane tmux_session client_tty app_id
  id="$(resolve "$1")"
  session="$(cat "$(aq_state_file "$id")")"
  IFS=$'\x1f' read -r cwd place opener pane tmux_session client_tty app_id < <(aq_jq -r "$JQ_DEFS
    [.cwd, place, app.open, .tmux_pane, tmux.session, tmux.client_tty, app.id]
    | map(. // \"\") | join(\"\\u001f\")" <<<"$session")

  if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
    notify "The session's directory ($cwd) no longer exists. Try: aq prune"
    exit 1
  fi

  # In tmux: switch the terminal showing the session's tmux session to the
  # session's pane (not whichever terminal tmux used last), then bring that
  # terminal forward.
  if [ -n "$tmux_session" ]; then
    if [ -z "$client_tty" ]; then
      notify "$place is in tmux session $tmux_session, which no terminal is showing. Run: tmux attach -t $tmux_session"
      exit 1
    fi
    tmux switch-client -c "$client_tty" -t "$pane"
    tmux select-window -t "$pane"
    tmux select-pane -t "$pane"
    [ -n "$app_id" ] && open -b "$app_id" 2>/dev/null
    return 0
  fi

  run_opener "$opener" "$session"
}

cmd_snooze() {
  [ $# -ge 1 ] || { usage >&2; exit 1; }
  local id dur="${2:-1h}" unit
  id="$(resolve "$1")"
  if ! [[ "$dur" =~ ^([0-9]+)([mhd])$ ]]; then
    echo "Can't read duration $dur. Use e.g. 30m, 2h or 1d." >&2
    exit 1
  fi
  case "${BASH_REMATCH[2]}" in m) unit=60 ;; h) unit=3600 ;; d) unit=86400 ;; esac
  aq_merge_state "$id" '.snoozed_until = $until' \
    --argjson until "$((NOW + BASH_REMATCH[1] * unit))"
  echo "Snoozed ${id:0:8} for $dur"
}

cmd_dismiss() {
  [ $# -ge 1 ] || { usage >&2; exit 1; }
  local id
  id="$(resolve "$1")"
  rm -f "$(aq_state_file "$id")"
  echo "Dismissed ${id:0:8}"
}

cmd_prune() {
  local removed
  removed="$(remove_stale "${1:-${AQ_PRUNE_DAYS:-3}}")"
  [ -n "$removed" ] && echo "$removed"
  echo "Pruned $(grep -c . <<<"$removed" || true) session(s)."
}

# One line per session, with no submenus: SwiftBar loses an item's submenu
# when the item's text changes between runs (and session lines change every
# minute), leaving it disabled. Clicking a line opens the session; holding
# Option swaps in an alternate line that dismisses it. Text is shortened
# here, because SwiftBar's own length param also broke submenus.
cmd_swiftbar() {
  states_json false | aq_jq -r --arg aq "$SELF" "$JQ_DEFS
    def clean: gsub(\"[|\\\"]\"; \"\");
    def trunc(\$n): if length > \$n then .[0:\$n - 1] + \"…\" else . end;
    def run(\$cmd; \$id): \" | bash=\" + \$aq + \" param1=\" + \$cmd + (\$id | if . then \" param2=\" + . else \"\" end) + \" terminal=false refresh=true\";
    def tooltip:
      [(.message // \"\" | select(. != \"\")),
       \"\(agent.name), running in \(where)\",
       \"Option-click to dismiss\"]
      | join(\". \") | clean;
    ([.[] | select(.status == \"needs-input\")] | length) as \$needs
    | ([.[] | select(.status == \"idle\")] | length) as \$idle
    | ([if \$needs > 0 then \"🟠 \(\$needs)\" else empty end, if \$idle > 0 then \"⚪ \(\$idle)\" else empty end]
       | if . == [] then \"✓\" else join(\" \") end),
      \"---\",
      (.[]
        | ({\"needs-input\": \"🟠\", \"working\": \"🔵\"}[.status] // \"⚪\") as \$icon
        | \"\(repo_emoji)\(app.emoji)\(agent.emoji)\(\$icon) \([place, (.updated_at | age), title] | join(\" · \") | clean | trunc(80))\"
            + run(\"open\"; .session_id) + \" tooltip=\\\"\(tooltip)\\\"\",
          \"✕ Dismiss: \([place, title] | join(\" · \") | clean | trunc(70))\"
            + run(\"dismiss\"; .session_id) + \" alternate=true\"),
      \"---\",
      \"Prune stale sessions\" + run(\"prune\"; null),
      \"Refresh | refresh=true\"
  "
}

case "${1:-list}" in
  list) shift || true; cmd_list "$@" ;;
  -a) cmd_list -a ;;
  open) shift; cmd_open "$@" ;;
  snooze) shift; cmd_snooze "$@" ;;
  dismiss) shift; cmd_dismiss "$@" ;;
  prune) shift; cmd_prune "$@" ;;
  --swiftbar) cmd_swiftbar ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
