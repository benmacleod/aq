#!/usr/bin/env bash
#
# Claude Code hook handler for cq. Reads the hook's JSON from stdin and
# records the session's state in ~/.claude/attention/<session_id>.json.
#
# Hook it up in ~/.claude/settings.json for SessionStart, UserPromptSubmit,
# Notification, Stop, SessionEnd, PreToolUse (AskUserQuestion|ExitPlanMode)
# and PostToolUse. See the README.
#
# It always exits 0 and prints nothing: a hook's stdout can end up in
# Claude's context, and a failing hook mustn't get in Claude's way. Errors go
# to $CQ_DIR/hook-errors.log.

set -uo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/cq.sh"

# Prints the PID of the Claude process running this hook: the nearest
# ancestor whose command mentions claude. Claude may start the hook through
# a shell, so $PPID alone isn't enough.
claude_pid() {
  local pid="$PPID" i
  for i in 1 2 3 4 5; do
    [ -n "$pid" ] && [ "$pid" -gt 1 ] || return 0
    if ps -o command= -p "$pid" | grep -q claude; then
      echo "$pid"
      return 0
    fi
    pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
  done
}

# process_host <pid>: prints what the process runs under: "tmux" if it is
# in a tmux pane, or else the bundle ID of the app that started it (e.g.
# dev.zed.Zed), or nothing if neither turns up among its ancestors.
#
# The environment can't tell you this. A Zed started from a terminal passes
# that terminal's __CFBundleIdentifier, TERM_PROGRAM and TMUX_PANE on to every
# agent it runs.
process_host() {
  local pid="$1" command
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    command="$(ps -o comm= -p "$pid")"
    case "$command" in
      tmux | tmux:* | */tmux) echo tmux; return 0 ;;
      # The outermost app, not e.g. Tabby Helper.app inside Tabby.app.
      /*.app/*)
        plutil -extract CFBundleIdentifier raw "${command%%.app/*}.app/Contents/Info.plist" 2>/dev/null
        return 0 ;;
    esac
    pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
  done
}

# Prints the name of the repo the directory is in: the last part of its
# origin URL (e.g. tc), or else the folder of its main checkout, so that
# every worktree of a repo gets the same name.
repo_name() {
  local url common
  url="$(git -C "$1" remote get-url origin 2>/dev/null)"
  if [ -n "$url" ]; then
    url="${url%/}"
    url="${url%.git}"
    echo "${url##*[/:]}"
  elif common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    basename "$(dirname "$common")"
  fi
}

short_title() {
  tr '\n\t' '  ' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//' | cut -c1-70
}

title_from_transcript() {
  [ -f "$1" ] || return 0
  grep -m1 '"type":"user"' "$1" \
    | jq -r '.message.content
             | if type == "string" then . else (map(select(.type == "text").text) | first // "") end' \
    2>/dev/null
}

# A plainer message for the tools that wait for you. Some clients (e.g. Zed)
# also ask permission for them, with a message naming the tool.
waiting_message() {
  case "$1" in
    AskUserQuestion) echo "Asking you a question" ;;
    ExitPlanMode) echo "Waiting for plan approval" ;;
  esac
}

# Asks Claude for a short title for a prompt, and stores it, unless a newer
# prompt has arrived since. Run it in the background: it takes a few
# seconds.
#
# The child Claude gets no tools, MCP servers or settings, so it can only
# reply, not try to carry out the prompt, and doesn't run your hooks.
# --no-session-persistence keeps it out of `claude --resume`, and
# CQ_HOOK_DISABLED is a backstop against this hook recording it.
summarize_title() {
  local id="$1" token="$2" prompt="$3" summary
  summary="$(
    printf '%s' "$prompt" | head -c 2000 \
      | CQ_HOOK_DISABLED=1 claude -p --model haiku --no-session-persistence \
          --tools "" --strict-mcp-config --setting-sources "" \
          --system-prompt "You write short titles for requests sent to a coding agent. You never carry out the request. Reply with a title of at most 6 words and nothing else: no quotes, no full stop." \
          "Title this request." 2>/dev/null \
      | head -n1 | sed -e 's/^["'\'' ]*//' -e 's/["'\''. ]*$//' | short_title
  )"
  [ -n "$summary" ] || return 0
  cq_merge_state "$id" 'if .title_token == $token then .title = $summary else . end' \
    --arg token "$token" --arg summary "$summary"
}

main() {
  local input event id cwd transcript now pid pid_started=""
  input="$(cat)"
  event="$(jq -r '.hook_event_name // empty' <<<"$input")"
  id="$(jq -r '.session_id // empty' <<<"$input")"
  [ -n "$id" ] || return 0
  cwd="$(jq -r '.cwd // empty' <<<"$input")"
  transcript="$(jq -r '.transcript_path // empty' <<<"$input")"
  now="$(cq_now)"

  # The Claude process, so cq can drop the session once it has gone (Zed
  # doesn't always send SessionEnd when you close a thread), and its
  # terminal, so cq can tell you which tab it's in.
  local tty="" host="" app="${__CFBundleIdentifier:-}" term_program="${TERM_PROGRAM:-}"
  local tmux_pane="${TMUX_PANE:-}"
  pid="$(claude_pid)"
  if [ -n "$pid" ]; then
    pid_started="$(cq_process_started "$pid")"
    tty="$(ps -o tty= -p "$pid" | tr -d ' ')"
    [ "$tty" = "??" ] && tty=""
    host="$(process_host "$pid")"
  fi
  # Outside tmux, any TMUX_PANE was passed down from elsewhere, and so was
  # TERM_PROGRAM if the app differs. "none" clears the recorded value.
  if [ -n "$host" ] && [ "$host" != "tmux" ]; then
    tmux_pane="none"
    [ "$host" = "$app" ] || term_program="none"
    app="$host"
  fi

  # update <jq filter> [jq args...]: applies the filter after refreshing the
  # fields every event sets. Fields with no value this time keep their old
  # one, and "none" clears it.
  #
  # app is the bundle ID of the app Claude runs in (e.g. dev.zed.Zed,
  # org.tabby): see process_host.
  update() {
    cq_merge_state "$id" "
      def keep(\$new): if \$new == \"\" then . elif \$new == \"none\" then null else \$new end;
      .session_id = \$id
      | .cwd |= keep(\$cwd)
      | .transcript_path |= keep(\$transcript)
      | .app |= keep(\$app)
      | .entrypoint |= keep(\$entrypoint)
      | .term_program |= keep(\$term_program)
      | .tmux_pane |= keep(\$tmux_pane)
      | .tty |= keep(\$tty)
      | .started_at = (.started_at // \$now)
      | if \$pid == \"\" then . else .pid = (\$pid | tonumber) | .pid_started = \$pid_started end
      | $1" \
      --arg id "$id" --arg cwd "$cwd" --arg transcript "$transcript" --argjson now "$now" \
      --arg app "$app" \
      --arg entrypoint "${CLAUDE_CODE_ENTRYPOINT:-}" \
      --arg term_program "$term_program" \
      --arg tmux_pane "$tmux_pane" \
      --arg tty "$tty" \
      --arg pid "$pid" --arg pid_started "$pid_started" "${@:2}"
  }

  needs_input() {
    update '.status = "needs-input" | .updated_at = $now | .message = $message' --arg message "$1"
  }

  branch() {
    git -C "$cwd" branch --show-current 2>/dev/null || true
  }

  # The branch can change during a session, and the repo too if you cd.
  # Recorded when a session starts and at the end of each turn.
  git_fields() {
    update ".branch = (if \$branch == \"\" then .branch else \$branch end)
      | .repo = (if \$repo == \"\" then .repo else \$repo end)
      | $1" --arg branch "$(branch)" --arg repo "$(repo_name "$cwd")" "${@:2}"
  }

  case "$event" in
    SessionStart)
      # "new" until the first prompt: Zed starts a session for a thread
      # whether or not you ever type into it. cq hides these.
      git_fields '.status = (.status // "new") | .updated_at = (.updated_at // $now)'
      ;;

    UserPromptSubmit)
      # Replying is the only thing that clears the flag: switching to the
      # window and away again leaves it set. The title is the latest prompt,
      # shortened; long prompts then get a summary from Claude in the
      # background. The token stops a slow summary from replacing a newer
      # prompt's title.
      local prompt token="$now-$RANDOM"
      prompt="$(jq -r '.prompt // empty' <<<"$input")"
      update '.status = "working"
        | .updated_at = $now
        | .message = null
        | .snoozed_until = null
        | .title = (if $title == "" then .title else $title end)
        | .title_token = $token' \
        --arg title "$(printf '%s' "$prompt" | short_title)" --arg token "$token"
      if [ "${CQ_SUMMARIZE:-1}" != "0" ] && [ "${#prompt}" -gt 50 ]; then
        summarize_title "$id" "$token" "$prompt" </dev/null >/dev/null 2>>"$CQ_DIR/hook-errors.log" &
        disown
      fi
      ;;

    Notification)
      # idle_prompt fires after Claude has sat idle for a minute. Stop already
      # marked the session idle, so it adds nothing.
      [ "$(jq -r '.notification_type // empty' <<<"$input")" = "idle_prompt" ] && return 0
      local message plain
      message="$(jq -r '.message // empty' <<<"$input")"
      # e.g. "Claude needs your permission to use AskUserQuestion"
      plain="$(waiting_message "${message##* }")"
      needs_input "${plain:-$message}"
      ;;

    PreToolUse)
      local message
      message="$(waiting_message "$(jq -r '.tool_name // empty' <<<"$input")")"
      [ -n "$message" ] && needs_input "$message"
      ;;

    PostToolUse)
      # A tool ran, so any permission prompt or question has been answered.
      # Only write on that change, since this fires after every tool call.
      local file
      file="$(cq_state_file "$id")"
      [ -f "$file" ] && [ "$(jq -r '.status' "$file")" = "needs-input" ] || return 0
      update '.status = "working" | .updated_at = $now | .message = null'
      ;;

    Stop)
      # The title comes from the transcript if the session has none, e.g.
      # because it started before these hooks were set up.
      local title=""
      [ -n "$(jq -r '.title // empty' "$(cq_state_file "$id")" 2>/dev/null)" ] \
        || title="$(title_from_transcript "$transcript" | short_title)"
      git_fields '.status = "idle"
        | .updated_at = $now
        | .message = null
        | .title = (if (.title // "") == "" then $title else .title end)' \
        --arg title "$title"
      ;;

    SessionEnd)
      rm -f "$(cq_state_file "$id")"
      ;;
  esac
}

# Set for the Claude that summarize_title runs, so its own session isn't
# recorded.
[ "${CQ_HOOK_DISABLED:-}" = "1" ] && exit 0

mkdir -p "$CQ_DIR" 2>/dev/null
main >/dev/null 2>>"$CQ_DIR/hook-errors.log"
exit 0
