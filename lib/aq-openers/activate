#!/usr/bin/env bash
#
# aq opener for apps with no better way to switch to a session: brings the
# app forward and says which tab the session is in. Most terminals can't be
# told to switch tabs.
#
# See "Openers" in the README for what an opener gets and must do.

if [ -n "$AQ_APP" ]; then
  open -b "$AQ_APP" 2>/dev/null
else
  open -a "$AQ_APP_NAME" 2>/dev/null
fi
echo "$AQ_PLACE is in $AQ_APP_NAME${AQ_TTY:+ ($AQ_TTY)}. Switch to its tab."
