#!/usr/bin/env bash
#
# cq opener for apps with no better way to switch to a session: brings the
# app forward and says which tab the session is in. Most terminals can't be
# told to switch tabs.
#
# See "Openers" in the README for what an opener gets and must do.

if [ -n "$CQ_APP" ]; then
  open -b "$CQ_APP" 2>/dev/null
else
  open -a "$CQ_APP_NAME" 2>/dev/null
fi
echo "$CQ_PLACE is in $CQ_APP_NAME${CQ_TTY:+ ($CQ_TTY)}. Switch to its tab."
